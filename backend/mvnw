#!/usr/bin/env sh
set -e
# Maven Wrapper script (Unix)
# See https://github.com/takari/maven-wrapper for details

MAVEN_WRAPPER_VERSION=0.5.6
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
WRAPPER_URL="https://repo.maven.apache.org/maven2/io/takari/maven-wrapper/${MAVEN_WRAPPER_VERSION}/maven-wrapper-${MAVEN_WRAPPER_VERSION}.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper..."
  mkdir -p .mvn/wrapper
  curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
fi

# Execute Maven Wrapper
java -jar "$WRAPPER_JAR" "$@"
