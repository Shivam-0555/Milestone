# .env.example

# Backend MySQL configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=milestone
DB_USERNAME=root
DB_PASSWORD=your_password

# JWT configuration
JWT_SECRET=YourSuperSecretKey
JWT_EXPIRATION_MS=86400000

# Frontend (Next.js) environment variables
NEXT_PUBLIC_API_URL=http://localhost:8080/api
